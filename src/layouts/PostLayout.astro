---
/**
 * 글 상세 (MDX Post)
 * 언어 → 제목 → 설명 → 메타 → 태그 → [모바일 목차] → 본문(MDX + Wasm Lab) → 하단 이동
 */
import SiteShell from '@layouts/SiteShell.astro';
import Toc from '@components/toc/Toc.astro';
import TagChip from '@components/post/TagChip.astro';
import PostMeta from '@components/post/PostMeta.astro';
import PostNav from '@components/post/PostNav.astro';
import { getLanguageNames, languageLabel, slugifyTag, type Post } from '@lib/site';

interface Props {
  post: Post;
  headings: { depth: number; slug: string; text: string }[];
  prev?: Post;
  next?: Post;
}

const { post, headings, prev, next } = Astro.props;
const { data } = post;
const languageNames = await getLanguageNames();

const eyebrow = [
  ...data.languages.map((id) => ({ label: languageLabel(languageNames, id), href: `/languages/${id}/` })),
];
---

<SiteShell
  title={data.title}
  description={data.description}
  headings={headings}
  ogType="article"
  noindex={data.noindex}
  alignTocToContent
>
  <article class="measure" itemscope itemtype="https://schema.org/BlogPosting" data-pagefind-body>
    <header
      class="flex min-h-[300px] flex-col justify-center bg-cover bg-center"
      style={data.cover ? `background-image: url(${JSON.stringify(data.cover)})` : undefined}
    >
      {
        eyebrow.length > 0 && (
          <p class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.8125rem] font-semibold text-copper">
            {eyebrow.map((item, index) => (
              <>
                {index > 0 && <span class="text-line-strong">·</span>}
                <a href={item.href} class="hover:underline">{item.label}</a>
              </>
            ))}
          </p>
        )
      }

      <h1
        class="text-[clamp(1.75rem,1.3rem+1.4vw,2.375rem)] leading-[1.24] font-bold tracking-[-0.02em] text-fg"
        itemprop="headline"
      >
        {data.title}
      </h1>

      {data.description && (
        <p class="mt-3 text-[1.0625rem] leading-relaxed text-fg-muted" itemprop="description">
          {data.description}
        </p>
      )}

      <PostMeta post={post} />

      <ul class="mt-4 flex flex-wrap gap-2">
        {
          data.tags.map((tag) => (
            <li>
              <TagChip label={tag} href={`/tags/${slugifyTag(tag)}/`} tone="plain" />
            </li>
          ))
        }
      </ul>
    </header>

    <div class="article-card mt-10">
      <Toc headings={headings} variant="inline" />

      <div class="prose" itemprop="articleBody">
        <slot />
      </div>

      <PostNav prev={prev} next={next} />
    </div>
  </article>
</SiteShell>
