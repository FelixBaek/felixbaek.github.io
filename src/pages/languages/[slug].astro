---
import { getCollection } from 'astro:content';
import AxisPage from '@components/page/AxisPage.astro';
import { getPostsByLanguage } from '@lib/site';

export async function getStaticPaths() {
  const languages = await getCollection('languages');
  return languages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const posts = await getPostsByLanguage(entry.id);
---

<AxisPage
  title={entry.data.name}
  eyebrow="Languages"
  definition={entry.data.summary}
  summary={entry.body}
  posts={posts}
  emptyHint="아직 공부 중이에요."
/>
