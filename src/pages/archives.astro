---
import SiteShell from '@layouts/SiteShell.astro';
import { formatDate, getAllPosts, getLanguageNames, languageLabel } from '@lib/site';

const posts = await getAllPosts();
const languageNames = await getLanguageNames();

const byYear = posts.reduce<Record<string, typeof posts>>((acc, post) => {
  const year = String(post.data.date.getFullYear());
  acc[year] = acc[year] ?? [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));
---

<SiteShell title="보관함" description={`전체 ${posts.length}개 기록`}>
  <header class="measure pt-2 pb-6">
    <h1 class="text-[1.75rem] leading-tight font-bold tracking-[-0.02em] text-fg">보관함</h1>
    <p class="mt-3 text-[0.9375rem] leading-relaxed text-fg-muted">
      전체 {posts.length}개 기록을 연도별로 모았습니다.
    </p>
  </header>

  {
    years.map((year) => (
      <section class="measure mb-8">
        <h2 class="mb-3 flex items-center gap-3 text-[0.6875rem] font-bold tracking-[0.1em] text-fg-caption uppercase">
          {year}년
          <span class="rounded border border-line px-1.5 text-[0.6875rem] font-semibold tabular-nums text-fg-muted">
            {byYear[year].length}
          </span>
          <span class="h-px flex-1 bg-line" />
        </h2>
        <ul class="flex flex-col">
          {byYear[year].map((post) => (
            <li class="flex items-baseline justify-between gap-4 border-b border-line py-2.5 last:border-b-0">
              <a class="text-[0.9375rem] font-medium text-fg hover:text-copper" href={`/posts/${post.id}/`}>
                {post.data.title}
              </a>
              <span class="flex-none text-[0.6875rem] tabular-nums text-fg-caption">
                {formatDate(post.data.date, 'short')}
                {post.data.languages.length > 0 && (
                  <span class="ml-2">
                    {post.data.languages.map((id) => languageLabel(languageNames, id)).join(', ')}
                  </span>
                )}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</SiteShell>
