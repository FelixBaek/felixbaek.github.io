---
/**
 * 홈 — 노트 헤더 + 기록 현황 + 최근 기록
 * (데모 배너 없음: 실제 운영 중인 아카이브의 입구)
 */
import SiteShell from '@layouts/SiteShell.astro';
import PostCard from '@components/post/PostCard.astro';
import { SITE, getAllPosts, getAxisCounts, getReviewQueue, formatDate } from '@lib/site';

const posts = await getAllPosts();
const counts = await getAxisCounts();
const review = await getReviewQueue();

const languages = Object.entries(counts).filter(([key]) => key.startsWith('languages:')).length;
const lastUpdated = posts[0]?.data.lastmod ?? posts[0]?.data.date;
---

<SiteShell>
  <section class="measure pt-2 pb-8">
    <p class="text-[0.6875rem] font-bold tracking-[0.1em] text-copper uppercase">학습 기록장</p>
    <h1 class="mt-3 text-[clamp(1.875rem,1.4rem+1.6vw,2.5rem)] leading-tight font-bold tracking-[-0.02em] text-fg">
      {SITE.title}
    </h1>
    <p class="mt-3 max-w-[38rem] text-[1.0625rem] leading-relaxed text-fg-muted">{SITE.description}</p>

    <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-4 border-t border-line pt-5">
      <div class="flex flex-col gap-0.5">
        <dt class="text-[0.6875rem] tracking-[0.04em] text-fg-caption">기록</dt>
        <dd class="text-[1.5rem] leading-none font-bold tabular-nums text-fg">{posts.length}</dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="text-[0.6875rem] tracking-[0.04em] text-fg-caption">언어</dt>
        <dd class="text-[1.5rem] leading-none font-bold tabular-nums text-fg">{languages}</dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="text-[0.6875rem] tracking-[0.04em] text-fg-caption">개념정리</dt>
        <dd class="text-[1.5rem] leading-none font-bold tabular-nums text-fg">
          {counts['harness:concept'] ?? 0}
        </dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="text-[0.6875rem] tracking-[0.04em] text-fg-caption">복습 대기</dt>
        <dd
          class:list={[
            'text-[1.5rem] leading-none font-bold tabular-nums',
            review.length > 0 ? 'text-amber' : 'text-fg',
          ]}
        >
          {review.length}
        </dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="text-[0.6875rem] tracking-[0.04em] text-fg-caption">Wasm 실험</dt>
        <dd class="text-[1.5rem] leading-none font-bold tabular-nums text-fg">
          {posts.filter((post) => post.data.wasm.length > 0).length}
        </dd>
      </div>
      {
        lastUpdated && (
          <div class="flex flex-col gap-0.5">
            <dt class="text-[0.6875rem] tracking-[0.04em] text-fg-caption">최근 업데이트</dt>
            <dd class="text-[1.0625rem] leading-none font-semibold tabular-nums text-fg">
              {formatDate(lastUpdated, 'short')}
            </dd>
          </div>
        )
      }
    </dl>
  </section>

  <section class="measure">
    <h2 class="mb-4 flex items-center gap-3 text-[0.6875rem] font-bold tracking-[0.1em] text-fg-caption uppercase">
      최근 기록
      <span class="h-px flex-1 bg-line"></span>
    </h2>

    <div>
      {posts.slice(0, 8).map((post) => <PostCard post={post} />)}
    </div>

    <p class="mt-6 text-[0.875rem] text-fg-muted">
      <a class="text-copper hover:underline" href="/archives/">전체 {posts.length}개 기록 보기</a>
      <span class="meta-dot" aria-hidden="true">·</span>
      <a class="text-copper hover:underline" href="/search/">검색</a>
      <span class="meta-dot" aria-hidden="true">·</span>
      <a class="text-copper hover:underline" href="/about/">소개</a>
    </p>
  </section>
</SiteShell>
