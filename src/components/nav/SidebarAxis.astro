---
/**
 * 사이드바 블록 공통 껍데기
 */
interface Props {
  label: string;
  hint?: string;
}

const { label, hint } = Astro.props;
---

<section class="flex flex-col gap-2">
  <h2 class="flex flex-col gap-0.5 border-b border-line pb-1.5">
    <span class="flex items-center gap-2">
      <span class="axis-dot axis-dot--neutral"></span>
      <span class="text-[0.6875rem] font-bold tracking-[0.1em] text-fg-caption uppercase">{label}</span>
      <slot name="count" />
    </span>
    {hint && <span class="pl-3.5 text-[0.6875rem] text-fg-caption">{hint}</span>}
  </h2>
  <slot />
</section>
