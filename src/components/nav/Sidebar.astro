---
/**
 * 좌측 기록 패널
 * Identity → Languages
 */
import { getCollection } from 'astro:content';
import { SITE, getLanguageCounts } from '@lib/site';

const languages = await getCollection('languages');
const languageCounts = await getLanguageCounts();
const sortedLanguages = languages.sort((a, b) => a.data.order - b.data.order);
const hasLanguages = sortedLanguages.length > 0;

const count = (name: string): number => languageCounts[name] ?? 0;
---

<div class="side-inner">
  <!-- Identity -->
  <header class="flex flex-col gap-2">
    <a href="/" class="text-[1.0625rem] font-bold tracking-tight text-fg">{SITE.title}</a>
    <p class="text-[0.8125rem] leading-relaxed text-fg-muted">{SITE.tagline}</p>

    <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[0.75rem] text-fg-muted">
      <li>
        <a class="hover:text-copper" href="/archives/">보관함</a>
      </li>
      <li>
        <a class="hover:text-copper" href="/search/">검색</a>
      </li>
      <li>
        <a class="hover:text-copper" href="/rss.xml">RSS</a>
      </li>
      <li>
        <button
          type="button"
          data-theme-toggle
          class="cursor-pointer hover:text-copper"
          aria-label="테마 전환 (시스템 → 라이트 → 다크)"
        >
          테마 <span data-theme-label>시스템</span>
        </button>
      </li>
      <li>
        <a class="hover:text-copper" href={SITE.github} rel="me noopener">GitHub</a>
      </li>
    </ul>
  </header>

  <!-- Languages -->
  {
    hasLanguages ? (
      <details class="sidebar-folder" open>
        <summary class="flex cursor-pointer items-center gap-2 border-b border-line pb-1.5">
          <span class="axis-dot axis-dot--lang" />
          <span class="text-[0.6875rem] font-bold tracking-[0.1em] text-fg-caption uppercase">Languages</span>
          <span class="sidebar-folder__chevron text-[0.75rem] leading-none text-fg-caption" aria-hidden="true">›</span>
        </summary>
        <ul class="sidebar-tree mt-2 flex flex-col gap-0.5">
          {sortedLanguages.map((entry) => {
            const c = count(entry.id);
            return (
              <li>
                <a
                  href={`/languages/${entry.id}/`}
                  class="sidebar-tree__item group flex items-baseline justify-between gap-2 rounded-r-md py-1.5 pr-2 pl-3 text-[0.875rem] text-fg hover:bg-surface-2 hover:text-copper"
                >
                  <span class="min-w-0 truncate">{entry.data.name}</span>
                  <span class="flex-none text-[0.6875rem] tabular-nums text-fg-caption">{c}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </details>
    ) : (
      <div class="flex items-center gap-2 border-b border-line pb-1.5">
        <span class="axis-dot axis-dot--lang" />
        <span class="text-[0.6875rem] font-bold tracking-[0.1em] text-fg-caption uppercase">Languages</span>
      </div>
    )
  }
</div>
