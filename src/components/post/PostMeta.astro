---
/**
 * 글 메타: 날짜 · 읽는 시간 · 수정일 · (Wasm 모듈 배지)
 */
import { formatDate, readingTime, type Post } from '@lib/site';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;

const minutes = readingTime(post.body ?? '');
const updated = data.lastmod && data.lastmod.valueOf() > data.date.valueOf() ? data.lastmod : undefined;
---

<div class="mt-4 flex flex-wrap items-center gap-x-1 gap-y-1 border-b border-line pb-4 text-[0.8125rem] text-fg-muted">
  <time class="tabular" datetime={data.date.toISOString()} itemprop="datePublished">
    {formatDate(data.date)}
  </time>
  <span class="meta-dot" aria-hidden="true">·</span>
  <span title="읽는 시간" data-reading-minutes>약 {minutes}분</span>

  {
    updated && (
      <>
        <span class="meta-dot" aria-hidden="true">·</span>
        <span class="text-fg-caption" itemprop="dateModified">
          수정 {formatDate(updated, 'short')}
        </span>
      </>
    )
  }

  {
    data.wasm.length > 0 && (
      <>
        <span class="meta-dot" aria-hidden="true">·</span>
        <span class="rounded px-1.5 py-0.5 text-[0.6875rem] font-semibold" style="color: var(--color-petrol); background: var(--color-petrol-soft);">
          Wasm {data.wasm.length}
        </span>
      </>
    )
  }
</div>
