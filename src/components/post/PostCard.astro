---
/**
 * 목록용 글 카드: 메타 → 제목 → 요약 → 태그
 */
import { formatDate, getLanguageNames, languageLabel, readingTime, slugifyTag, type Post } from '@lib/site';
import TagChip from './TagChip.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;
const languageNames = await getLanguageNames();
const minutes = readingTime(post.body ?? '');
const languageLabels = data.languages.map((id) => languageLabel(languageNames, id));
---

<article class="border-b border-line py-5 first:pt-0 last:border-b-0">
  <div class="flex flex-wrap items-center gap-x-1 text-[0.75rem] text-fg-caption">
    <time class="tabular" datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
    <span class="meta-dot" aria-hidden="true">·</span>
    <span>약 {minutes}분</span>
    {
      languageLabels.length > 0 && (
        <>
          <span class="meta-dot" aria-hidden="true">·</span>
          <span>{languageLabels.join(', ')}</span>
        </>
      )
    }
  </div>

  <h3 class="mt-2 text-[1.125rem] leading-snug font-semibold tracking-[-0.015em]">
    <a href={`/posts/${post.id}/`} class="text-fg hover:text-copper">{data.title}</a>
  </h3>

  <p class="mt-2 text-[0.9375rem] leading-relaxed text-fg-muted">{data.description}</p>

  <ul class="mt-3 flex flex-wrap gap-2">
    {
      data.languages.map((id) => (
        <li>
          <TagChip label={languageLabel(languageNames, id)} href={`/languages/${id}/`} tone="lang" />
        </li>
      ))
    }
    {
      data.tags.slice(0, 3).map((tag) => (
        <li>
          <TagChip label={tag} href={`/tags/${slugifyTag(tag)}/`} tone="plain" />
        </li>
      ))
    }
  </ul>
</article>
