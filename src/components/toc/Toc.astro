---
/**
 * 목차 (TOC)
 * variant="aside"  → 우측 고정 패널 (xl 이상)
 * variant="inline" → 본문 상단 접이식 (xl 미만)
 * 현재 읽는 섹션 강조는 site.ts 의 스크롤 추적이 담당한다.
 */
export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  variant?: 'aside' | 'inline';
}

const { headings, variant = 'aside' } = Astro.props;

// depth 2~3만, 최소 2개 이상일 때만 노출
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3).slice(0, 24);
const visible = filtered.length >= 2;
const count = filtered.length;
---

{
  visible && variant === 'aside' && (
    <nav class="flex flex-col gap-3 text-[0.875rem]" aria-label="이 글의 목차" data-toc>
      <p class="text-[0.6875rem] font-bold tracking-[0.1em] text-fg-caption uppercase">목차</p>
      <div
        class="max-h-[calc(100vh-9rem)] overflow-y-auto pr-1.5"
        data-toc-scroll
      >
        <ol class="border-l border-line">
          {filtered.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                data-toc-link
                class:list={[
                  'block border-l-2 border-transparent py-1 leading-snug text-fg-muted transition-colors hover:text-fg',
                  heading.depth === 3 ? 'pl-6 text-[0.8125rem]' : 'pl-3',
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )
}

{
  visible && variant === 'inline' && (
    <details class="toc-inline mt-6 rounded-lg border border-line bg-surface-2 px-4 py-3 xl:hidden">
      <summary class="flex cursor-pointer items-center justify-between text-[0.875rem] font-semibold text-fg [&::-webkit-details-marker]:hidden">
        <span>목차</span>
        <span class="text-[0.6875rem] font-normal text-fg-caption">{count}개 섹션</span>
      </summary>
      <ol class="mt-3 border-l border-line">
        {filtered.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              data-toc-link
              class:list={[
                'block border-l-2 border-transparent py-1 text-[0.8125rem] leading-snug text-fg-muted hover:text-copper',
                heading.depth === 3 ? 'pl-6' : 'pl-3',
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  )
}

<style>
  /* 활성 항목 강조 (site.ts 가 .is-active 를 붙인다) */
  a.is-active {
    color: var(--color-copper) !important;
    border-left-color: var(--color-copper) !important;
    font-weight: 600;
  }
</style>
